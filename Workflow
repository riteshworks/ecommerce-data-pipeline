      "parameters": {
        "jsCode": "// 1. Read input payload\nlet fileData = '';\n\nfor (const item of $input.all()) {\n  if (item.binary) {\n    const binaryKey = Object.keys(item.binary)[0];\n    if (binaryKey && item.binary[binaryKey].data) {\n      fileData += Buffer.from(item.binary[binaryKey].data, 'base64').toString('utf-8');\n      continue;\n    }\n  }\n\n  if (typeof item.json === 'string') {\n    fileData += item.json + '\\n';\n  } else if (item.json?.data && typeof item.json.data === 'string') {\n    fileData += item.json.data + '\\n';\n  } else if (item.json?.body && typeof item.json.body === 'string') {\n    fileData += item.json.body + '\\n';\n  }\n}\n\nif (!fileData.trim()) {\n  throw new Error(\"No text/binary content found in input item.\");\n}\n\nconst lines = fileData.split('\\n').filter(line => line.trim() !== '');\n\nconst ordersMap = {};\nconst lineItemsMap = {};\nconst refundsMap = {};\nconst discountMap = {};\n\n// PASS 1: Index all objects\nfor (const line of lines) {\n  try {\n    const obj = JSON.parse(line);\n\n    // --- ORDER ---\n    if (obj.id && obj.id.includes('/Order/')) {\n      let paymentGateway = '';\n      if (Array.isArray(obj.paymentGatewayNames) && obj.paymentGatewayNames.length > 0) {\n        paymentGateway = obj.paymentGatewayNames.join(', ');\n      } else if (typeof obj.paymentGatewayNames === 'string') {\n        paymentGateway = obj.paymentGatewayNames;\n      }\n\n      let discountCodes = '';\n      if (Array.isArray(obj.discountCodes) && obj.discountCodes.length > 0) {\n        discountCodes = obj.discountCodes.join(', ');\n      }\n\n      let fulfilledAt = null;\n      if (Array.isArray(obj.fulfillments) && obj.fulfillments.length > 0 && obj.fulfillments[0].createdAt) {\n        fulfilledAt = new Date(obj.fulfillments[0].createdAt).toISOString();\n      }\n\n      ordersMap[obj.id] = {\n        _rawId: obj.id,\n        order_id: parseInt(obj.id.split('/').pop(), 10),\n        order_number: obj.name || '',\n        created_at: obj.createdAt ? new Date(obj.createdAt).toISOString() : null,\n        updated_at: obj.updatedAt ? new Date(obj.updatedAt).toISOString() : null,\n        cancelled_at: obj.cancelledAt ? new Date(obj.cancelledAt).toISOString() : null,\n        fulfilled_at: fulfilledAt,\n        email: obj.email || '',\n        accepts_marketing: Boolean(obj.customerAcceptsMarketing),\n        fulfillment_status: obj.displayFulfillmentStatus || 'UNFULFILLED',\n        total: parseFloat(obj.totalPriceSet?.shopMoney?.amount || 0),\n        discount_amount: parseFloat(obj.totalDiscountsSet?.shopMoney?.amount || 0),\n        discount_codes: discountCodes,\n        payment_method: paymentGateway,\n        billing_name: obj.billingAddress\n          ? `${obj.billingAddress.firstName || ''} ${obj.billingAddress.lastName || ''}`.trim()\n          : '',\n        billing_phone: obj.billingAddress?.phone || '',\n        billing_city_name: obj.billingAddress?.city || '',\n        billing_state_name: obj.billingAddress?.province || ''\n      };\n    }\n\n    // --- LINE ITEM ---\n    else if (obj.id && obj.id.includes('/LineItem/')) {\n      lineItemsMap[obj.id] = obj;\n    }\n\n    // --- REFUND TRANSACTION ---\n    else if (obj.id && obj.id.includes('/OrderTransaction/')) {\n      if (obj.kind === 'REFUND' && obj.status === 'SUCCESS') {\n        const amount = parseFloat(obj.amount || 0);\n        if (obj.__parentId) {\n          refundsMap[obj.__parentId] = (refundsMap[obj.__parentId] || 0) + amount;\n        }\n      }\n    }\n\n    // --- DISCOUNT APPLICATION ---\n    else if (\n      obj.__parentId &&\n      obj.__parentId.includes('/Order/') &&\n      (obj.code !== undefined || obj.allocationMethod !== undefined)\n    ) {\n      if (!discountMap[obj.__parentId]) {\n        discountMap[obj.__parentId] = { codes: [], details: [] };\n      }\n      if (obj.code) {\n        discountMap[obj.__parentId].codes.push(obj.code);\n      }\n      discountMap[obj.__parentId].details.push({\n        code: obj.code || '',\n        type: obj.value?.percentage != null ? 'percentage' : 'fixed',\n        value: obj.value?.percentage ?? obj.value?.amount ?? 0\n      });\n    }\n\n  } catch (err) {\n    continue;\n  }\n}\n\n// PASS 1.5: Override discount_codes using discountApplications child data\nfor (const [orderId, order] of Object.entries(ordersMap)) {\n  if (discountMap[orderId] && discountMap[orderId].codes.length > 0) {\n    order.discount_codes = discountMap[orderId].codes.join(', ');\n  }\n}\n\nconst itemsToInsert = [];\n\n// PASS 2: Sort line items by numeric ID\nconst sortedLineItems = Object.values(lineItemsMap).sort((a, b) => {\n  const aId = parseInt(a.id.split('/').pop(), 10);\n  const bId = parseInt(b.id.split('/').pop(), 10);\n  return aId - bId;\n});\n\nconst colourMap = {\n  'OR': 'Orange', 'YL': 'Yellow', 'SG': 'Sea Green',\n  'BK': 'Black', 'WH': 'White', 'RD': 'Red',\n  'BL': 'Blue', 'NV': 'Navy', 'GR': 'Green',\n  'GY': 'Grey', 'PK': 'Pink', 'MR': 'Maroon',\n  'BR': 'Brown', 'PL': 'Purple', 'BG': 'Beige',\n  'CR': 'Cream', 'MG': 'Magenta', 'TL': 'Teal',\n  'OL': 'Olive', 'RS': 'Rose', 'LV': 'Lavender',\n  'MT': 'Mustard', 'PE': 'Peach', 'CO': 'Coral',\n  'IN': 'Indigo', 'CH': 'Charcoal', 'SK': 'Sky Blue',\n  'WN': 'Wine', 'RU': 'Rust', 'BT': 'Bottle Green',\n  'OW': 'Off White',\n};\n\nconst orderItemTracker = {};\n\nfor (const item of sortedLineItems) {\n  const parentOrder = ordersMap[item.__parentId];\n  if (!parentOrder) continue;\n\n  const lineItemId = parseInt(item.id.split('/').pop(), 10);\n  const isFirst = !orderItemTracker[parentOrder.order_id];\n  orderItemTracker[parentOrder.order_id] = true;\n\n  const rawSku = item.sku || '';\n  let cleanSize = '';\n  let cleanColour = '';\n\n  // STEP 1: Extract from selectedOptions — primary source, most accurate\n  if (item.variant && Array.isArray(item.variant.selectedOptions)) {\n    for (const option of item.variant.selectedOptions) {\n      const optName = (option.name || '').toLowerCase().trim();\n      if (optName.includes('size')) cleanSize = option.value;\n      else if (optName.includes('color') || optName.includes('colour')) cleanColour = option.value;\n    }\n  }\n\n  // STEP 2: Fallback — parse from variant title, only fill what's still missing\n  if ((!cleanSize || !cleanColour) && item.variant?.title && item.variant.title !== 'Default Title') {\n    const parts = item.variant.title.split('/').map(p => p.trim());\n    if (parts.length >= 2) {\n      if (!cleanSize) cleanSize = parts[0];\n      if (!cleanColour) cleanColour = parts[1];\n    } else if (parts.length === 1) {\n      const val = parts[0];\n      if (!cleanSize && /^(XS|S|M|L|XL|XXL|XXXL|[0-9]+)$/i.test(val)) {\n        cleanSize = val;\n      } else if (!cleanColour) {\n        cleanColour = val;\n      }\n    }\n  }\n\n  // STEP 3+4: SKU-based extraction — only fills what's still missing (variant null or incomplete)\n  if ((!cleanSize || !cleanColour) && rawSku) {\n    if (!cleanSize) {\n      const skuSizeMatch = rawSku.match(/(XS|XXL|XXXL|XL|[SML])$/i);\n      if (skuSizeMatch) cleanSize = skuSizeMatch[1].toUpperCase();\n    }\n    if (!cleanColour && cleanSize) {\n      const withoutSize = rawSku.slice(0, rawSku.length - cleanSize.length);\n      const colourCode = withoutSize.slice(3, 5).toUpperCase();\n      cleanColour = colourMap[colourCode] || colourCode;\n    }\n  }\n\n  const refundedAmount = isFirst ? (refundsMap[item.__parentId] || 0) : 0;\n\n  itemsToInsert.push({\n    json: {\n      line_item_id: lineItemId,\n      order_id: parentOrder.order_id,\n      order_number: parentOrder.order_number,\n      sku: rawSku,\n      size: cleanSize,\n      colour: cleanColour,\n      lineitem_quantity: item.quantity || 1,\n      is_first_line_item: isFirst,\n      total: isFirst ? parentOrder.total : 0.00,\n      discount_amount: isFirst ? parentOrder.discount_amount : 0.00,\n      refunded_amount: parseFloat(refundedAmount.toFixed(2)),\n      discount_codes: parentOrder.discount_codes,\n      email: parentOrder.email,\n      accepts_marketing: parentOrder.accepts_marketing,\n      billing_name: parentOrder.billing_name,\n      billing_phone: parentOrder.billing_phone,\n      billing_city_name: parentOrder.billing_city_name,\n      billing_state_name: parentOrder.billing_state_name,\n      payment_method: parentOrder.payment_method,\n      fulfillment_status: parentOrder.fulfillment_status,\n      fulfilled_at: parentOrder.fulfilled_at,\n      created_at: parentOrder.created_at,\n      cancelled_at: parentOrder.cancelled_at,\n      updated_at: parentOrder.updated_at\n    }\n  });\n}\n\n// PASS 3: Orders with zero line items\nfor (const [orderId, order] of Object.entries(ordersMap)) {\n  if (orderItemTracker[order.order_id]) continue;\n\n  itemsToInsert.push({\n    json: {\n      line_item_id: order.order_id * -1,\n      order_id: order.order_id,\n      order_number: order.order_number,\n      sku: null,\n      size: null,\n      colour: null,\n      lineitem_quantity: 0,\n      is_first_line_item: true,\n      total: order.total,\n      discount_amount: order.discount_amount,\n      refunded_amount: parseFloat((refundsMap[orderId] || 0).toFixed(2)),\n      discount_codes: order.discount_codes,\n      email: order.email,\n      accepts_marketing: order.accepts_marketing,\n      billing_name: order.billing_name,\n      billing_phone: order.billing_phone,\n      billing_city_name: order.billing_city_name,\n      billing_state_name: order.billing_state_name,\n      payment_method: order.payment_method,\n      fulfillment_status: order.fulfillment_status,\n      fulfilled_at: order.fulfilled_at,\n      created_at: order.created_at,\n      cancelled_at: order.cancelled_at,\n      updated_at: order.updated_at\n    }\n  });\n}\n\nreturn itemsToInsert;\n"
      },
